300E  14A1          ADD R2, R2, #1                   | ADD R2, R2, #1      ; bit 15 de R0 = 1
300F  1000          ADD R0, R0, R0                   | SQ_B1       ADD R0, R0, R0      ; siguiente bit a la posicion 15
3010  1482          ADD R2, R2, R2                   | ADD R2, R2, R2      ; R = 2R
3011  1020          ADD R0, R0, #0                   | ADD R0, R0, #0
