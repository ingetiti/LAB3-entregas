30F6  54A0          AND R2, R2, #0                   | AND R2 R2 #0                        ;   [R2] carry = 0
30F7  16E0          ADD R3, R3, #0                   | ADD R3 R3 #0                        ;
30F8  0601          BRzp #1   ; -> x30FA             | BRzp sumover_test_b                 ;   if valor_a & 0x8000:
30F9  14A1          ADD R2, R2, #1                   | ADD R2 R2 #1                        ;       carry += 1
30FA  1260          ADD R1, R1, #0                   | ADD R1 R1 #0                        ;
30FB  0601          BRzp #1   ; -> x30FD             | BRzp sumover_sum                    ;   if valor_b & 0x8000:
30FC  14A1          ADD R2, R2, #1                   | ADD R2 R2 #1                        ;       carry += 1
30FD  2818          LD R4, #24   ; -> x3116          | LD R4 sumover_mask                  ;
30FE  56C4          AND R3, R3, R4                   | AND R3 R3 R4                        ;   valor_a = valor_a & 0x7FFF
30FF  5244          AND R1, R1, R4                   | AND R1 R1 R4                        ;   valor_b = valor_b & 0x7FFF
3100  1003          ADD R0, R0, R3                   | ADD R0 R0 R3                        ;
3101  1001          ADD R0, R0, R1                   | ADD R0 R0 R1                        ;   resultado = resultado + valor_a + valor_b
3102  0601          BRzp #1   ; -> x3104             | BRzp sumover_resultant              ;   if resultado & 0x8000:
3103  14A1          ADD R2, R2, #1                   | ADD R2 R2 #1                        ;       carry += 1
3104  5004          AND R0, R0, R4                   | AND R0 R0 R4                        ;   resultado = resultado & 0x7FFF
3105  58A1          AND R4, R2, #1                   | AND R4 R2 #1                        ;
3106  0402          BRz #2   ; -> x3109              | BRz sumover_test_carry              ;   if carry & 0x0001:
3107  280F          LD R4, #15   ; -> x3117          | LD R4 sumover_msb                   ;
3108  1004          ADD R0, R0, R4                   | ADD R0 R0 R4                        ;       resultado = resultado + 0x8000
3109  58A2          AND R4, R2, #2                   | AND R4 R2 #2                        ;
310A  0403          BRz #3   ; -> x310E              | BRz sumover_test_carry_else         ;   if carry & 0x0002:
310B  54A0          AND R2, R2, #0                   | AND R2 R2 #0                        ;
310C  14A1          ADD R2, R2, #1                   | ADD R2 R2 #1                        ;       carry = 1
310D  0E01          BRnzp #1   ; -> x310F            | BRnzp sumover_ret                   ;   else:
310E  54A0          AND R2, R2, #0                   | AND R2 R2 #0                        ;       carry = 0
