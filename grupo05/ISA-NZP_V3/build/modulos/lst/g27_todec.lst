30F7  14A1          ADD R2, R2, #1                   | ADD R2 R2 #1                        ;       carry += 1
30F8  2818          LD R4, #24   ; -> x3111          | LD R4 sumover_mask                  ;
30F9  56C4          AND R3, R3, R4                   | AND R3 R3 R4                        ;   valor_a = valor_a & 0x7FFF
30FA  5244          AND R1, R1, R4                   | AND R1 R1 R4                        ;   valor_b = valor_b & 0x7FFF
30FB  1003          ADD R0, R0, R3                   | ADD R0 R0 R3                        ;
30FC  1001          ADD R0, R0, R1                   | ADD R0 R0 R1                        ;   resultado = resultado + valor_a + valor_b
30FD  0601          BRzp #1   ; -> x30FF             | BRzp sumover_resultant              ;   if resultado & 0x8000:
30FE  14A1          ADD R2, R2, #1                   | ADD R2 R2 #1                        ;       carry += 1
30FF  5004          AND R0, R0, R4                   | AND R0 R0 R4                        ;   resultado = resultado & 0x7FFF
3100  58A1          AND R4, R2, #1                   | AND R4 R2 #1                        ;
3101  0402          BRz #2   ; -> x3104              | BRz sumover_test_carry              ;   if carry & 0x0001:
3102  280F          LD R4, #15   ; -> x3112          | LD R4 sumover_msb                   ;
3103  1004          ADD R0, R0, R4                   | ADD R0 R0 R4                        ;       resultado = resultado + 0x8000
3104  58A2          AND R4, R2, #2                   | AND R4 R2 #2                        ;
3105  0403          BRz #3   ; -> x3109              | BRz sumover_test_carry_else         ;   if carry & 0x0002:
3106  54A0          AND R2, R2, #0                   | AND R2 R2 #0                        ;
3107  14A1          ADD R2, R2, #1                   | ADD R2 R2 #1                        ;       carry = 1
3108  0E01          BRnzp #1   ; -> x310A            | BRnzp sumover_ret                   ;   else:
3109  54A0          AND R2, R2, #0                   | AND R2 R2 #0                        ;       carry = 0
310A  2203          LD R1, #3   ; -> x310E           | LD R1 sumover_r1                    ;
310B  2603          LD R3, #3   ; -> x310F           | LD R3 sumover_r3                    ;
310C  2803          LD R4, #3   ; -> x3110           | LD R4 sumover_r4                    ;
310D  C1C0          RET                              | RET                                 ;
310E  0000                                           | sumover_r1          .FILL #0
310F  0000                                           | sumover_r3          .FILL #0
3110  0000                                           | sumover_r4          .FILL #0
3111  7FFF                                           | sumover_mask        .FILL x7FFF
3112  8000                                           | sumover_msb         .FILL x8000
